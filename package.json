{
  "name": "localeproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "test": "node --test tests/core.test.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "worker": "node --env-file=.env scripts/worker.mjs",
    "browser:install": "npx playwright-core install chromium",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:production": "node --test tests/production.test.mjs"
  },
  "dependencies": {
    "gsap": "3.15.0",
    "ipaddr.js": "2.3.0",
    "nuxt": "4.6.2",
    "pg": "8.16.3",
    "playwright-core": "1.64.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "@types/pg": "8.15.6",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vue-tsc": "3.1.1"
  }
}
