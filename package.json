{
  "name": "localeproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "start": "node .output/server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "worker": "node --env-file=.env scripts/worker.mjs",
    "browser:install": "npx playwright-core install chromium"
  },
  "dependencies": {
    "nuxt": "3.21.11",
    "vue": "3.5.43",
    "gsap": "3.15.0",
    "playwright-core": "1.64.0",
    "ipaddr.js": "1.9.1"
  }
}
