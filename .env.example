# Copy to .env. Never commit credentials.
DATABASE_URL=postgresql://localeproof:localeproof@127.0.0.1:5432/localeproof
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_TOKEN=
# Exact hostnames, including asset hosts. No wildcard hosts.
ALLOWED_SCAN_HOSTS=
# Persistent volume shared by app and worker; screenshots are served behind owner auth.
EVIDENCE_DIR=./data/evidence
# Optional installed Chromium path. Otherwise use npm run browser:install.
CHROMIUM_EXECUTABLE_PATH=
